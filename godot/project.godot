; Engine configuration file.
; Aurum — modular game engine foundation built on Godot 4.7.
;
; This project hosts the engine add-on plus two tutorial demos:
; 2D squares (movement + collision + score) and 3D bounce (gravity
; + jumping). Game projects that build on Aurum live in separate
; repositories (see README.md for the full architecture diagram).

config_version=5

[application]

config/name="Aurum"
config/description="Modular game engine foundation built on Godot 4.7 + Rust. Includes 2D and 3D tutorial demos."
run/main_scene="res://demos/2d_squares/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Aurum="*res://scripts/aurum_runtime.gd"

[display]

window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/aurum/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=3
environment/defaults/default_clear_color=Color(0, 0, 0.05, 1)
rendering_device/driver.windows="d3d12"
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
