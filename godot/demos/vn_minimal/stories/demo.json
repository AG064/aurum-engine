{
  "meta": {
    "title": "Aurum VN demo",
    "version": "0.1.0"
  },
  "scenes": {
    "start": {
      "display_name": "TITLE",
      "background": "black",
      "entries": [
        { "type": "text", "data": "..." },
        { "type": "text", "data": "A phone vibrates somewhere nearby." },
        { "type": "dialogue", "text": "Once." },
        { "type": "dialogue", "text": "Twice.", "append": true },
        { "type": "dialogue", "text": "Then silence.", "append": true },
        { "type": "goto", "target": "morning" }
      ]
    },
    "morning": {
      "display_name": "BEDROOM — MORNING",
      "background": "default",
      "entries": [
        { "type": "text", "data": "Grey morning light slips through the blinds, drawing narrow lines across the wall." },
        { "type": "text", "data": "You open your eyes." },
        { "type": "dialogue", "speaker": "You", "presentation": "thought", "text": "Five more minutes..." },
        { "type": "text", "data": "You close your eyes." },
        { "type": "text", "data": "..." },
        { "type": "dialogue", "speaker": "You", "text": "All right. I'm up." },
        { "type": "text", "data": "You throw the blanket aside and sit on the edge of the bed." },
        { "type": "text", "data": "Outside, the apartment blocks sit beneath a pale autumn sky." },
        { "type": "dialogue", "text": "Just another morning.", "append": true },
        { "type": "choice", "choices": [
          { "text": "Make coffee", "goto": "coffee" },
          { "text": "Check your phone", "goto": "phone" },
          { "text": "Go back to sleep", "goto": "sleep" }
        ]}
      ]
    },
    "coffee": {
      "display_name": "KITCHEN",
      "background": "default",
      "entries": [
        { "type": "text", "data": "You shuffle into the kitchen, half-awake." },
        { "type": "text", "data": "The coffee maker gurgles. The smell alone is enough to feel human again." },
        { "type": "dialogue", "speaker": "You", "text": "Okay. Day one." },
        { "type": "goto", "target": "ending" }
      ]
    },
    "phone": {
      "display_name": "BEDROOM",
      "background": "default",
      "entries": [
        { "type": "text", "data": "You reach across the bed and pick up the phone." },
        { "type": "text", "data": "Three notifications. One message from a friend you keep meaning to reply to." },
        { "type": "dialogue", "speaker": "You", "presentation": "thought", "text": "Later. Maybe." },
        { "type": "set", "variable": "checked_phone", "value": true },
        { "type": "goto", "target": "ending" }
      ]
    },
    "sleep": {
      "display_name": "BEDROOM",
      "background": "default",
      "entries": [
        { "type": "text", "data": "You pull the blanket back over your head." },
        { "type": "text", "data": "The morning will wait." },
        { "type": "text", "data": "..." },
        { "type": "text", "data": "...it really won't, actually." },
        { "type": "dialogue", "speaker": "You", "text": "Ugh. Fine." },
        { "type": "goto", "target": "ending" }
      ]
    },
    "ending": {
      "display_name": "—",
      "background": "black",
      "entries": [
        { "type": "text", "data": "— end of demo —" },
        { "type": "text", "data": "Variable values:" },
        { "type": "set", "variable": "demo_done", "value": true }
      ]
    }
  },
  "variables": {
    "checked_phone": false,
    "demo_done": false
  }
}
